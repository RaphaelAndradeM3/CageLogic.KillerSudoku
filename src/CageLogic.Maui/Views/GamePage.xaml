<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CageLogic.Maui.Controls"
             x:Class="CageLogic.Maui.Views.GamePage"
             Title="Partida"
             BackgroundColor="#F5F6F8">
    <ScrollView>
        <VerticalStackLayout Padding="12,10,12,20" Spacing="10" MaximumWidthRequest="620" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Killer Sudoku" FontSize="22" FontAttributes="Bold" TextColor="#14243A"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding DifficultyLabel, StringFormat='Dificuldade: {0}'}" FontSize="13" TextColor="#526174" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Voltar" Clicked="OnBackClicked" BackgroundColor="#E8EDF4" TextColor="#25354A"
                        SemanticProperties.Hint="Volta à seleção de dificuldade" />
            </Grid>

            <controls:KillerSudokuBoardView x:Name="BoardView" AutomationId="KillerSudokuBoard"
                                             MaximumWidthRequest="560" HorizontalOptions="Center" />

            <Label Text="{Binding StatusMessage}" TextColor="#9A3D35" FontSize="13"
                   SemanticProperties.Description="Estado da entrada" />

            <Label Text="Digite um número" FontSize="15" FontAttributes="Bold" TextColor="#25354A"
                   SemanticProperties.HeadingLevel="Level2" />
            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" RowSpacing="6" ColumnSpacing="6">
                <Button Text="1" Clicked="OnDigitClicked" />
                <Button Grid.Column="1" Text="2" Clicked="OnDigitClicked" />
                <Button Grid.Column="2" Text="3" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Text="4" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Text="7" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnDigitClicked" />
            </Grid>
            <Button Text="Apagar célula selecionada" Command="{Binding ClearSelectedCommand}"
                    BackgroundColor="#E8EDF4" TextColor="#25354A"
                    SemanticProperties.Hint="Apaga a resposta da célula selecionada" />
            <Label Text="Use as setas para mover a seleção. Os conflitos são indicados no tabuleiro e anunciados pelo leitor de tela."
                   FontSize="12" TextColor="#526174" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
