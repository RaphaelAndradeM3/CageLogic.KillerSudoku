<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CageLogic.Maui.Controls"
             x:Class="CageLogic.Maui.Views.GamePage"
             Title="Partida">
    <ScrollView>
        <VerticalStackLayout Padding="12,10,12,20" Spacing="10" MaximumWidthRequest="620" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Killer Sudoku" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#14243A, Dark=#F3F6FA}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding DifficultyLabel, StringFormat='Dificuldade: {0}'}" FontSize="13" TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}" />
                    <Label Text="{Binding ViewState.ActiveElapsed, StringFormat='Tempo ativo: {0:hh\\:mm\\:ss}'}" FontSize="13" TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Voltar" Clicked="OnBackClicked"
                        BackgroundColor="{AppThemeBinding Light=#E8EDF4, Dark=#364557}"
                        TextColor="{AppThemeBinding Light=#25354A, Dark=#F3F6FA}"
                        SemanticProperties.Hint="Volta à seleção de dificuldade" />
            </Grid>

            <controls:KillerSudokuBoardView x:Name="BoardView" AutomationId="KillerSudokuBoard"
                                             MaximumWidthRequest="560" HorizontalOptions="Center" />

            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#9A3D35, Dark=#FF9D92}" FontSize="13"
                   SemanticProperties.Description="Estado da entrada" />
            <Label Text="{Binding PersistenceStatus}" TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}" FontSize="12"
                   SemanticProperties.Description="Estado do salvamento local da partida" />
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSaving}">
                <ActivityIndicator IsRunning="{Binding IsSaving}" Color="#315F9D" />
                <Label Text="Salvando..." TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}" VerticalOptions="Center"
                       SemanticProperties.Description="A alteração está sendo salva e ainda não foi confirmada." />
            </HorizontalStackLayout>
            <Label Text="{Binding HintMessage}" TextColor="{AppThemeBinding Light=#334F70, Dark=#BCD7F5}" FontSize="14"
                   SemanticProperties.Description="Explicação da dica" />

            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" IsVisible="{Binding IsHintPending}">
                <ActivityIndicator IsRunning="{Binding IsHintPending}" IsVisible="{Binding IsHintPending}" Color="#315F9D" />
                <Label Text="Calculando dica..." TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}" VerticalOptions="Center"
                       SemanticProperties.Description="Uma dica está sendo calculada; a edição do tabuleiro continua disponível." />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Text="{Binding ViewState.InputMode, StringFormat='Modo: {0}'}" Command="{Binding ToggleInputModeCommand}"
                        SemanticProperties.Hint="Alterna entre inserir resposta e editar candidatos" />
                <Button Grid.Column="1" Text="Preencher candidatos" Command="{Binding AutoFillCandidatesCommand}"
                        SemanticProperties.Hint="Substitui as notas de todas as células vazias pelos candidatos atuais" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Text="Desfazer" Command="{Binding UndoCommand}" IsEnabled="{Binding ViewState.CanUndo}" />
                <Button Grid.Column="1" Text="Refazer" Command="{Binding RedoCommand}" IsEnabled="{Binding ViewState.CanRedo}" />
                <Button Grid.Column="2" Text="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                        SemanticProperties.Hint="Pausar ou retomar explicitamente o cronômetro ativo" />
                <Button Grid.Column="3" Text="Pedir dica" Command="{Binding RequestHintCommand}"
                        SemanticProperties.Hint="Mostra o próximo nível de explicação lógica" />
            </Grid>

            <Label Text="Digite um número" FontSize="15" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}"
                   SemanticProperties.HeadingLevel="Level2" />
            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" RowSpacing="6" ColumnSpacing="6">
                <Button Text="1" Clicked="OnDigitClicked" AutomationId="Digit1" />
                <Button Grid.Column="1" Text="2" Clicked="OnDigitClicked" AutomationId="Digit2" />
                <Button Grid.Column="2" Text="3" Clicked="OnDigitClicked" AutomationId="Digit3" />
                <Button Grid.Row="1" Text="4" Clicked="OnDigitClicked" AutomationId="Digit4" />
                <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnDigitClicked" AutomationId="Digit5" />
                <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnDigitClicked" AutomationId="Digit6" />
                <Button Grid.Row="2" Text="7" Clicked="OnDigitClicked" AutomationId="Digit7" />
                <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnDigitClicked" AutomationId="Digit8" />
                <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnDigitClicked" AutomationId="Digit9" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Text="Apagar célula selecionada" Command="{Binding ClearSelectedCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E8EDF4, Dark=#364557}"
                        TextColor="{AppThemeBinding Light=#25354A, Dark=#F3F6FA}"
                        SemanticProperties.Hint="Apaga a resposta ou as notas da célula selecionada" />
                <Button Grid.Column="1" Text="{Binding CompleteButtonText}" Command="{Binding CompleteCommand}"
                        BackgroundColor="{AppThemeBinding Light=#DDEBDD, Dark=#294638}"
                        TextColor="{AppThemeBinding Light=#1D542A, Dark=#D7F5E1}"
                        SemanticProperties.Hint="Valida e conclui a partida quando a solução estiver correta" />
            </Grid>
            <Button Text="Abandonar partida" Clicked="OnAbandonClicked"
                    BackgroundColor="{AppThemeBinding Light=#F4E1DF, Dark=#512E32}"
                    TextColor="{AppThemeBinding Light=#782F2A, Dark=#FFD8D4}"
                    SemanticProperties.Hint="Pede confirmação e registra a partida como abandonada" />
            <Label Text="Use as setas para mover a seleção. Ctrl+Z desfaz e Ctrl+Y refaz. Conflitos e destaques de dica também são descritos para leitores de tela."
                   FontSize="12" TextColor="{AppThemeBinding Light=#526174, Dark=#C1CBD8}"
                   SemanticProperties.Description="Instruções de teclado e acessibilidade" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
