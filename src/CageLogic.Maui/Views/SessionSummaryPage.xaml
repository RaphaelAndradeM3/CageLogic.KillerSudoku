<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CageLogic.Maui.Views.SessionSummaryPage"
             Title="Resumo da partida">
    <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="520" HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="Partida concluída" FontSize="28" FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#14243A, Dark=#F3F6FA}"
               SemanticProperties.HeadingLevel="Level1" />
        <Label Text="O tabuleiro corresponde à solução confirmada." FontSize="16"
               TextColor="{AppThemeBinding Light=#334F70, Dark=#BCD7F5}" />
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <Label Text="Dificuldade" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Column="1" Text="{Binding Summary.Difficulty}" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="1" Text="Tempo ativo" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Summary.ActiveTime, StringFormat='{0:hh\\:mm\\:ss}'}" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="2" Text="Jogadas conflitantes" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Summary.ErrorCount}" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="3" Text="Níveis de dica exibidos" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Summary.DisplayedHintLevelCount}" TextColor="{AppThemeBinding Light=#25354A, Dark=#E4EAF2}" />
        </Grid>
        <Button Text="Voltar ao início" Clicked="OnHomeClicked"
                BackgroundColor="{AppThemeBinding Light=#DDEBDD, Dark=#294638}"
                TextColor="{AppThemeBinding Light=#1D542A, Dark=#D7F5E1}"
                SemanticProperties.Hint="Volta para escolher uma nova partida" />
    </VerticalStackLayout>
</ContentPage>
